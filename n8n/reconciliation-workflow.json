{
  "name": "reconciliation-clickup",
  "meta": {
    "description": "Webhook → map fields → POST ClickUp API (list id only). No team/space/folder dropdowns."
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "decision",
      "parameters": {
        "httpMethod": "POST",
        "path": "decision",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "map-fields",
      "name": "Map ClickUp Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [500, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "tn",
              "name": "task_name",
              "value": "={{$json.task_name || $json.description || ($json.decision + ' — ' + $json.transaction_id)}}",
              "type": "string"
            },
            {
              "id": "tb",
              "name": "task_body",
              "value": "={{'Description: ' + ($json.description || $json.task_name || 'n/a') + '\\nCounterparty: ' + ($json.counterparty || 'n/a') + '\\nAmount: ' + ($json.amount != null ? $json.amount : 'n/a') + ' ' + ($json.currency || '') + '\\nDate: ' + ($json.date || 'n/a') + '\\nTransaction ID: ' + $json.transaction_id + '\\nStatus: ' + $json.decision + '\\nConfidence: ' + $json.confidence + '\\nRisk score: ' + $json.risk_score + '\\nFactors: ' + $json.risk_factors + '\\nReasoning: ' + ($json.reasoning || '') + '\\nMethod: ' + $json.method}}",
              "type": "string"
            },
            {
              "id": "pr",
              "name": "priority",
              "value": "={{$json.high_priority ? 1 : 3}}",
              "type": "number"
            }
          ]
        }
      }
    },
    {
      "id": "clickup-urgent",
      "name": "ClickUp Urgent Task",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "position": [960, 180],
      "parameters": {
        "resource": "task",
        "operation": "create",
        "list": "PASTE_CLICKUP_LIST_ID",
        "name": "={{$json.task_name}}",
        "additionalFields": {
          "content": "={{$json.task_body}}",
          "priority": 1
        }
      },
      "notes": "Set ClickUp credential + List ID. Priority 1 = Urgent (risk_score > 0.8)."
    },
    {
      "id": "clickup-normal",
      "name": "ClickUp Review Task",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "position": [960, 420],
      "parameters": {
        "resource": "task",
        "operation": "create",
        "list": "PASTE_CLICKUP_LIST_ID",
        "name": "={{$json.task_name}}",
        "additionalFields": {
          "content": "={{$json.task_body}}",
          "priority": 3
        }
      },
      "notes": "Normal priority for pending_review / flagged below 0.8."
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Map ClickUp Fields", "type": "main", "index": 0 }]]
    },
    "Map ClickUp Fields": {
      "main": [[{ "node": "IF high_priority", "type": "main", "index": 0 }]]
    },
    "IF high_priority": {
      "main": [
        [{ "node": "ClickUp Urgent Task", "type": "main", "index": 0 }],
        [{ "node": "ClickUp Review Task", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {}
}
